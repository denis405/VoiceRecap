BOT_TOKEN=123456:ABC...
OPENROUTER_API_KEY=sk-or-v1-...
ADMIN_ID=63730416
STT_MODEL=openai/whisper-large-v3-turbo
SUMMARY_MODEL=anthropic/claude-haiku-5.5
# model thinking before the answer: true costs 2-4x more
SUMMARY_REASONING=false
# ISO-639-1 code (ru, en, ...); auto = auto-detect. Default for users; each can change it in /settings
STT_LANGUAGE=ru
MAX_DURATION_SEC=3600
MAX_CONCURRENT_JOBS=3
# a repeated voice / video note (same Telegram file) reuses its recap for this many days
RECAP_CACHE_TTL_DAYS=7
